# Application Settings
APP_NAME="Australian Compliance Automation Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/acagp"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# TimescaleDB (for time-series compliance data)
TIMESCALE_ENABLED=true

# Authentication & Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS Configuration
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_CLOUDTRAIL_BUCKET=""
AWS_CONFIG_BUCKET=""
AWS_S3_REPORTS_BUCKET=""

# Azure Configuration
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SUBSCRIPTION_ID=""
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""

# Redis (for Celery task queue)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Compliance Engine Configuration
COMPLIANCE_CHECK_INTERVAL_MINUTES=15
MAX_CONCURRENT_ASSESSMENTS=5
ENABLE_AUTO_REMEDIATION=false

# Report Generation
REPORTS_OUTPUT_DIR="./reports/generated"
REPORTS_TEMPLATE_DIR="./reports/templates"
REPORTS_LOGO_PATH="./assets/logo.png"

# Monitoring & Observability
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# ML Model Configuration
ML_MODELS_DIR="./ml_models"
ML_TRAINING_ENABLED=false
ML_RISK_PREDICTION_THRESHOLD=0.75

# Feature Flags
FEATURE_APRA_CPS234=true
FEATURE_ESSENTIAL_EIGHT=true
FEATURE_OAIC_NDB=true
FEATURE_PCI_DSS=true
FEATURE_ISO27001=false
FEATURE_ML_RISK_PREDICTION=false

# Email Notifications (for breach notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="compliance@example.com"
SMTP_TLS=true

# Logging
LOG_FORMAT="json"
LOG_FILE_PATH="./logs/acagp.log"
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=90
